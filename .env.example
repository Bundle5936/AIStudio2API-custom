# 账户状态文件、目录或逗号分隔的多个路径
AISTUDIO_AUTH_STATES=auth

# 服务监听地址 (Docker 内部必须监听 0.0.0.0)
LISTEN_ADDR=0.0.0.0:2048

# 本地 API 认证密钥 (留空表示不校验)
PROXY_API_KEY=

# setup 与未指定账户共同使用的 HTTP、HTTPS 或 SOCKS5 代理
PROXY=

# 单账户初始化超时
INIT_TIMEOUT=2m

# 普通请求最大执行时间
REQUEST_TIMEOUT=5m

# 常驻预热账户数 (云服务器建议 1~2，桌面端可调高)
WARM_WORKER_LIMIT=1

# 高峰期最多同时运行的 Worker 数 (2 核云 VPS 建议 2，防止并发打满 CPU)
MAX_ACTIVE_WORKERS=2

# 服务启动时同时预热的账户数
WARM_STARTUP_CONCURRENCY=1

# 单账号同时处理的请求数
PER_ACCOUNT_CONCURRENCY=2

# WAA 预热是否使用临时对话
TEMPORARY_CHAT=false

# 是否禁用无头服务器低功耗优化 (默认 false，即默认开启低功耗无渲染优化)
# DISABLE_HEADLESS_OPTIMIZATIONS=false
